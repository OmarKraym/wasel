# ---- Public (browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Used inside QR codes: https://{DOMAIN}/scan/{qr_token}
NEXT_PUBLIC_APP_URL=https://wasla.example.ly

# ---- Server only (never expose) ----
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Meta app (Messenger + Instagram messaging)
META_APP_SECRET=your-meta-app-secret
META_VERIFY_TOKEN=a-long-random-string-you-also-paste-in-meta-dashboard
META_GRAPH_VERSION=v21.0

# 32 random bytes, base64. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Secret pepper for phone HMAC. Generate: openssl rand -base64 32
# NEVER rotate casually: rotating it resets all phone reputation history.
PHONE_HASH_PEPPER=
